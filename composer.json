{
    "name": "tyhpdef/symfony-expression-language-impl",
    "description": "Implementation package for tyhpdef/symfony-expression-language. Require tyhpdef/symfony-expression-language, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.18.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-cache": "@dev",
                "tyhpdef/symfony-cache-contracts": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/psr-clock": "@dev",
                "tyhpdef/php-ext-memcached": "@dev",
                "tyhpdef/psr-container": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-expression-language"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/expression-language": "7.4.18"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-cache": "@dev",
        "tyhpdef/symfony-cache-contracts": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/psr-clock": "@dev",
        "tyhpdef/php-ext-memcached": "@dev",
        "tyhpdef/psr-container": "@dev"
    }
}
